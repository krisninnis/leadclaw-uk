NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -----------------------------------------------------------------
# Production deployments MUST use live credentials (sk_live_/pk_live_ + live
# price IDs). Preview & Development deployments MUST use test credentials
# (sk_test_/pk_test_ + test price IDs). The app enforces this at runtime via
# VERCEL_ENV (see src/lib/stripe-environment.ts) and fails closed on a mismatch.
# In Vercel, scope live values to the Production environment ONLY and test
# values to Preview/Development ONLY -- never "All Environments".
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Monthly recurring Stripe Price IDs (use test price IDs in Preview/Dev):
# Growth = GBP 79/month
STRIPE_PRICE_GROWTH=
# Pro = GBP 149/month
STRIPE_PRICE_PRO=

# Escape hatch: set to "true" ONLY for non-Vercel hosting where VERCEL_ENV is
# unavailable. Permits a key/mode mismatch instead of failing closed. Leave unset.
STRIPE_ALLOW_MODE_MISMATCH=

ALERT_WEBHOOK_URL=
ADMIN_EXPORT_TOKEN=
LEAD_IMPORT_TOKEN=
LEADCLAW_IMPORT_URL=
GITHUB_ACTIONS_DISPATCH_TOKEN=
LEAD_FINDER_CALLBACK_TOKEN=
LEAD_FINDER_SCHEDULER_TOKEN=
OUTREACH_RUN_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=
ADMIN_EMAILS=
FOUNDER_ALERT_EMAIL=
OUTREACH_DAILY_CAP=
OUTREACH_BATCH_SIZE=
OUTREACH_MIN_LEAD_QUALITY_SCORE=
BILLING_RUN_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
